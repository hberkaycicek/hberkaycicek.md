def print_champion_info(CH):
    feats = CH["features_model"]
    b0s, bs = CH["intercept_std"], CH["coef_std"]
    mu, sd  = CH["scaler_mean"],   CH["scaler_std"]
    b0r, br = CH["intercept_raw"], CH["coef_raw"]

    print("\n=== CHAMPION MODEL BİLGİLERİ ===")
    print("Features      :", feats)
    print("Intercept(std):", round(b0s, 6))
    print("Coef(std)     :", [round(x, 6) for x in bs])
    print("Mean          :", [round(x, 6) for x in mu])
    print("Std           :", [round(x, 6) for x in sd])

    std_terms = " + ".join([f"({bs[i]:.6f} * z_{feats[i]})" for i in range(len(feats))])
    print("\nSTD uzay formülü:")
    print(f"  y_hat = {b0s:.6f} + {std_terms}")

    raw_terms = " + ".join([f"({br[i]:.6f} * {feats[i]})" for i in range(len(feats))])
    print("\nHAM uzay formülü (manuel kullanım için en pratik):")
    print(f"  y_hat = {b0r:.6f} + {raw_terms}")


def predict_12m90_manual(feature_degerleri, CH):
    """
    feature_degerleri: {"2M30": 0.3915, "4M60": 0.12, ...} (yüzde cinsinden)
    """
    feats = CH["features_model"]
    eksik = [f for f in feats if f not in feature_degerleri]
    if eksik:
        raise ValueError(f"Eksik feature: {eksik}. Gerekli: {feats}")

    x = np.array([float(feature_degerleri[f]) for f in feats])

    z     = (x - CH["scaler_mean"]) / CH["scaler_std"]
    y_std = CH["intercept_std"] + np.sum(CH["coef_std"] * z)
    y_raw = CH["intercept_raw"] + np.sum(CH["coef_raw"] * x)

    return {
        "girdiler":      dict(zip(feats, x.round(6))),
        "z_degerleri":   dict(zip(feats, z.round(6))),
        "tahmin_std":    y_std,
        "tahmin_raw":    y_raw,
        "kontrol_farki": abs(y_std - y_raw),
    }


